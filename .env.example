# Copy to .env for local development. In production (EC2), these are set as
# real process environment variables by systemd (EnvironmentFile) sourced
# from SSM Parameter Store / Secrets Manager — see docs/AWS_MIGRATION.md.

# Postgres connection string (RDS in production; a local/dev Postgres here).
DATABASE_URL="postgres://user:password@localhost:5432/cheer4bharat"

# Shared-secret keys the app used to store in the app_secrets table.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
INGEST_KEY=""
AGENT_KEY=""
STATUS_KEY=""

# "true" to expose the Sarvam voice widget config at /api/public/voice-config.
VOICE_ENABLED="false"
SARVAM_EMBED_KEY=""
